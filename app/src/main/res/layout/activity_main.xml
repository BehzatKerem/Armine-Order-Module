<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/login_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_menu_header"
                android:textColor="@color/login_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_menu_subtitle"
                android:textColor="@color/login_subtitle"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/profile_button"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_profile" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipChildren="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProducts"
                style="@style/Widget.Armine.MenuButton"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/menu_products"
                app:icon="@drawable/ic_menu_products"
                app:iconTint="@color/menu_icon_bg_products" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomers"
                style="@style/Widget.Armine.MenuButton"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/menu_customers"
                app:icon="@drawable/ic_menu_customers"
                app:iconTint="@color/menu_icon_bg_customers" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:clipChildren="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWarehouses"
                style="@style/Widget.Armine.MenuButton"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/menu_warehouses"
                app:icon="@drawable/ic_menu_warehouses"
                app:iconTint="@color/menu_icon_bg_warehouses" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWholesaleOrder"
                style="@style/Widget.Armine.MenuButton"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/menu_wholesale_order"
                app:icon="@drawable/ic_menu_order"
                app:iconTint="@color/menu_icon_bg_order" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:clipChildren="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWarehouseTransfer"
                style="@style/Widget.Armine.MenuButton"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/menu_warehouse_transfer"
                app:icon="@drawable/ic_menu_transfer"
                app:iconTint="@color/menu_icon_bg_transfer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRfidCounting"
                style="@style/Widget.Armine.MenuButton"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/menu_rfid_counting"
                app:icon="@drawable/ic_menu_rfid"
                app:iconTint="@color/menu_icon_bg_rfid" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRfidScan"
            style="@style/Widget.Armine.MenuButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/menu_rfid_scan"
            app:icon="@drawable/ic_menu_rfid"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="24dp"
            app:iconTint="@color/menu_icon_bg_rfid" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAppUpdate"
        style="@style/Widget.Armine.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_status_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/dotRfidStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dot_red" />

        <TextView
            android:id="@+id/tvRfidStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_rfid_status_disconnected"
            android:textColor="@color/login_subtitle"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
