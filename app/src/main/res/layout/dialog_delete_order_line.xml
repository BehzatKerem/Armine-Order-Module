<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvDeleteScanMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wholesale_order_delete_scan_message"
        android:textColor="@color/login_title"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvDeleteScanTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/login_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeleteEpc"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/wholesale_order_delete_epc_hint"
        app:boxStrokeColor="@color/login_primary"
        app:hintTextColor="@color/login_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeleteEpc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvDeleteScanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/wholesale_order_delete_scan_hint"
        android:textColor="@color/login_subtitle"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvDeleteScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/login_error"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
