<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvStockErrorsMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/warehouse_transfer_stock_errors_message"
        android:textColor="@color/login_subtitle"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvStockErrorsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/warehouse_transfer_stock_errors_empty"
        android:textColor="@color/login_subtitle"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStockErrors"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp"
        android:background="@color/login_background"
        android:clipToPadding="false"
        android:padding="6dp" />

</LinearLayout>
