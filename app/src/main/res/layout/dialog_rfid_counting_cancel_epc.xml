<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvCancelEpcMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rfid_counting_cancel_barcode_message"
        android:textColor="@color/login_title"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCancelEpcHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/rfid_counting_cancel_barcode_scan_hint"
        android:textColor="@color/login_subtitle"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCancelEpcEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/rfid_counting_cancel_barcode_empty"
        android:textColor="@color/login_subtitle"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCancelEpcs"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvCancelEpcStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/login_error"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
