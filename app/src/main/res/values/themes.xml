<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ArmineOrderModule" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/login_primary</item>
        <item name="colorPrimaryVariant">@color/login_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/menu_icon_bg_customers</item>
        <item name="colorSecondaryVariant">@color/menu_icon_bg_customers</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/login_background</item>
        <item name="android:navigationBarColor">@color/login_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowBackground">@color/login_background</item>
        <item name="materialButtonStyle">@style/Widget.Armine.PrimaryButton</item>
        <item name="textInputStyle">@style/Widget.Armine.TextInput</item>
    </style>
</resources>