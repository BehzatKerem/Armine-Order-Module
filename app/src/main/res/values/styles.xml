<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Armine.MenuButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">140dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/login_title</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@animator/menu_button_state_list_anim</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">14dp</item>
        <item name="iconSize">36dp</item>
        <item name="iconTint">@color/login_primary</item>
        <item name="rippleColor">#221E3A5F</item>
    </style>
</resources>
